conda activate photodedup

# 1. 画像分類
./classify_images.pl source

---
# 1. 重複検出
python photo_dedup_v3.py pic-classifier
# 2.ハッシュが完全一致した画像を削除 + 類似度の高い画像をまとめて移動
python photo_dedup_apply.py pic-classifier --yes
# 3.目視確認した画像をsourceへ戻す
python photo_dedup_apply.py pic-classifier --restore --review-dir ./review_YYYY-MM-DD --yes

---
# 1. NSFW検出
python photo_nsfw_scan.py pic-classifier
# 2. NSFWを nsfw_review_YYMMDD へ、UNCERTAINを uncertain_review_YYMMDD へ移動）
python photo_nsfw_apply.py pic-classifier --yes
